{
	"name": "consentaro/consentaro",
	"description": "Ultra-light Google Consent Mode v2 WordPress plugin",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0"
	},
	"autoload": {
		"psr-4": {
			"Consentaro\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Consentaro\\Tests\\": "tests/"
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"brain/monkey": "^2.6"
	},
	"scripts": {
		"test": "phpunit"
	}
}
